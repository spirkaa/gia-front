{
  "name": "gia-front",
  "description": "React frontend for Django REST Framework",
  "version": "3.0.0",
  "license": "MIT",
  "author": "piv@devmem.ru",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node compress.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "prettier"
    ]
  },
  "prettier": {
    "printWidth": 88,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "always"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.15",
    "normalizr": "^3.2.3",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-bootstrap-table-ng": "^5.19.6",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-redux": "^9.3.0",
    "react-router-bootstrap": "^0.26.3",
    "react-router-dom": "^6.30.6",
    "react-toastify": "^11.1.0",
    "react-ultimate-pagination": "^1.3.2",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "react-scripts": "5.0.1",
    "redux-logger": "^3.0.6"
  }
}
