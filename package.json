{
  "name": "gia-front",
  "description": "React frontend for Django REST Framework",
  "version": "3.0.0",
  "license": "MIT",
  "author": "piv@devmem.ru",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "prettier": {
    "printWidth": 88,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "always"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "events": "^3.3.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "normalizr": "^3.6.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-bootstrap-table-ng": "^5.19.6",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "redux-logger": "^3.0.6",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11"
  }
}
